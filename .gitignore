__pycache__/
*.py[cod]
.venv/
venv/
# Secrets. `.env` alone matches only a file named exactly that, so it does not
# cover deploy/solvent.env or anything else a real deployment might leave in the
# tree. These patterns are a safety net, not the boundary: the real file lives
# at /etc/solvent/solvent.env, outside the repository entirely.
.env
*.env
!*.env.example
solvent.env
secrets/
*.key
*.pem
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
models/
*.gguf
*.safetensors

# Build output for the Windows installer. The compiled DeskPilot-Setup.exe and
# the payload it carries are both reproducible from `windows/installer/build.py`
# at a given commit, so the binaries do not belong in history -- and a 1 MB
# executable committed per build would grow the repository without adding
# anything that cannot be rebuilt.
windows/installer/dist/
