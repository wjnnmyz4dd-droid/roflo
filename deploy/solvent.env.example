# Copy to /etc/solvent/solvent.env, chown root:solvent, chmod 0640, then fill in.
#
# 0640, not 0600: root owns the file and the solvent group reads it. 0600 is
# root-only, so the service -- which runs as the solvent user -- could not read
# it, and every credential here would report as missing. `deploy/install.sh`
# already installs it correctly; this note is for anyone doing it by hand.
#
# THIS FILE IS A TEMPLATE. It contains no secrets and never should.
# The real file is not in the repository, is not in backups (see backup.sh),
# and is not readable by worker processes.

# Owner signing key. Without it, consequential approvals fail closed --
# which is the safe direction, not a bug. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SOLVENT_OWNER_KEY=

# Stripe webhook signing secret (whsec_...). Only the payment ingress reads it.
# Solvent never writes it to the database and never logs it.
SOLVENT_STRIPE_WEBHOOK_SECRET=

# Model runtime. These must name the artifact cleared under OD-3; a different
# tag here is a silent downgrade, and `solvent health` will refuse it.
ROFLO_BACKEND=ollama
ROFLO_MODEL=qwen2.5:14b-instruct
