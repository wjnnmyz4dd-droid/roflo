# Copy to /etc/solvent/solvent-web.env, chown root:solvent-web, chmod 0640.
#
# THIS FILE IS A TEMPLATE. It contains no secrets and never should.
#
# Note what is NOT here, deliberately: SOLVENT_OWNER_KEY and any payment secret.
# The control centre must not be able to mint an owner approval or verify a
# payment, so it is not given the means. If you find yourself adding either of
# those lines here, the thing you are trying to do belongs in the runtime.

# The owner's control-centre password, as a PBKDF2 hash. Generate it with:
#   solvent web-password
# That command prompts, does not echo, and prints only the hash. The hash cannot
# be turned back into the password.
SOLVENT_WEB_PASSWORD_HASH=
